{
  "expo": {
    "name": "Budget by MyTools",
    "slug": "budget-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budget-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "bundleIdentifier": "eu.mytoolsgroup.budget",
      "supportsTablet": false
    },
    "android": {
      "package": "eu.mytoolsgroup.budget"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Budget by MyTools à accéder à la caméra pour scanner vos documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Budget by MyTools à accéder à votre galerie pour importer des documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
